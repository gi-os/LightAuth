<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: codes are computed offline from the stored secret. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      allowBackup is off on purpose. The secrets are sealed with a non-exportable
      AndroidKeyStore key, so a restored database on another device would hold
      blobs nothing can decrypt — worse than starting empty.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Authenticator"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightAuth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Authenticator"
            android:theme="@style/Theme.LightAuth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
